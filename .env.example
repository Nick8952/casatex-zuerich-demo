# Umgebungsvariablen der Casatex-Website. Diese Datei enthält KEINE Geheimnisse und darf im Repository stehen.
# Die GitHub-Pages-Demo braucht keine einzige dieser Variablen: `npm run build` läuft ohne .env.
# Für lokale Versuche nach .env.local kopieren (wird nicht committet).

# ── Betriebsart ──────────────────────────────────────────────────────────────
# leer oder "pages": statischer Export unter dem Repository-Unterpfad (GitHub Pages)
# "vercel":          statischer Export ohne Unterpfad (Vercel oder Kundendomain); `npm run build:vercel` setzt das selbst
DEPLOY_TARGET=

# Öffentliche Adresse der Website: nur Protokoll und Domain, ohne Pfad. Leer = Standard (GitHub Pages bzw. <repo>.vercel.app).
# Für den Produktivbetrieb die Kundendomain eintragen, zum Beispiel https://www.beispiel.ch
# Lässt sich nicht mit dem Unterpfad der GitHub-Pages-Demo kombinieren (nur mit DEPLOY_TARGET=vercel oder BASE_PATH="").
SITE_URL=

# Nur für einen Export an einer Domain-Wurzel ohne Vercel: BASE_PATH="" (ausdrücklich leer) setzen.
# BASE_PATH=

# "1" erlaubt die Indexierung: kein noindex mehr, Sitemap und strukturierte Daten (JSON-LD) werden erzeugt.
# Verlangt eine ausdrückliche SITE_URL und ist für Vorschau-Adressen (github.io, vercel.app, localhost) gesperrt.
# Der Build bricht ab, solange Inhalte nicht vom Unternehmen freigegeben sind (Liste: npm run inhalt:pruefen -- --live).
INDEXIERUNG=

# ── Inhalte ──────────────────────────────────────────────────────────────────
# leer oder "lokal": Inhalte aus data/*.json (Demo)
# "sanity":          Inhalte beim Build aus Sanity lesen (braucht die beiden Angaben darunter)
CONTENT_SOURCE=

# Sanity-Projekt (nicht geheim). Erst nach dem Anlegen des Projekts ausfüllen: docs/SANITY-VERCEL-EINRICHTUNG.md
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Nur bei einem privaten Dataset nötig: Token mit Leserecht. GEHEIM, nie committen, nur in Vercel bzw. .env.local.
# SANITY_API_READ_TOKEN=

# Nur für den Import (npm run seed): Token mit Schreibrecht. GEHEIM, nur lokal in .env.local, danach in Sanity wieder löschen.
# SANITY_API_WRITE_TOKEN=
